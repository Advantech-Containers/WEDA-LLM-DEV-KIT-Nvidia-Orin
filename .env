# ==============================================================================
# WEDA LLM Suite (JetPack 6 / Orin) — environment template
#
# Fill in the placeholders, then run:
#     ./build.sh
# ==============================================================================

# ── Image ─────────────────────────────────────────────────────────────────────
WEDA_LLM_IMAGE=harbor.edgesync.cloud/weda-release/weda-llm-base:1.0.0-orin

# ── Container Identity ────────────────────────────────────────────────────────
WEDA_LLM_CONTAINER_NAME=weda-llm-suite
# Bind address for ALL bundle servers (generation, embedding, gateway).
# Loopback by default: network_mode is host, so 0.0.0.0 exposes every
# unauthenticated endpoint -- including the gateway, which executes tools and
# reads device telemetry -- on every interface. Set 0.0.0.0 only behind a
# firewall, to call the API from another machine.
WEDA_LLM_PORT=9000
WEDA_LLM_HOST=127.0.0.1
# Embedding API (RAG mode only; second llama-server process).
WEDA_EMBED_PORT=9001
# Application gateway (Web UI model list = the applications).
WEDA_GATEWAY_PORT=9002
# Browser origins allowed to call the gateway directly, comma-separated. Empty
# (the default) sends no cross-origin headers at all: the Web UI reaches the
# gateway from its own backend, so nothing in this bundle needs one. Set it
# only for your own browser client, e.g. http://192.168.1.20:3000 -- the
# gateway executes tools and has no authentication.
WEDA_GATEWAY_ALLOWED_ORIGINS=

# ── Model Configuration ───────────────────────────────────────────────────────
# Model parameters (GGUF repo, quant, context, GPU layers) live in
# config/llm_config.yaml. Select a profile here or per-run via build.sh.
# Precedence: ./build.sh -p <profile>  beats this value, which beats
# default_profile in the yaml. This value is read at container creation --
# changing it takes ./build.sh --stop && ./build.sh (only yaml edits
# hot-swap a running server).
LLM_PROFILE=

# ── HuggingFace ───────────────────────────────────────────────────────────────
#HF_TOKEN=
# Models are downloaded ONLY by scripts/download_models.py into HF_CACHE;
# serving never fetches (an uncached model is refused with the download
# command). Set 1 to also block Hugging Face metadata lookups -- optional,
# the deployment is offline-capable as soon as its models are cached.
HF_HUB_OFFLINE=0
# Host model cache. Point at an existing HF cache (~/.cache/huggingface) to
# reuse downloads; the default keeps everything inside this bundle.
HF_CACHE=./model_cache/huggingface

# ── RAG documents ─────────────────────────────────────────────────────────────
# Host directory mounted (read-only) as the corpus root for RAG applications.
# Apps address subdirectories via their docs_dir key, relative to this mount.
DOCS_DIR=./docs_sample

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3
# Host directory for in-container test artifacts (image-level wise-bench).
TEST_LOGS_DIR=./test_logs

# ── Web UI CORS ───────────────────────────────────────────────────────────────
# Default '*' (Open WebUI stock). To harden, set this to the origin browsers
# actually use for THIS device -- the UI's websocket checks it on every
# connection, so a wrong value shows "Connection lost. Reconnecting...".
# Multiple origins separate with ';'.
#CORS_ALLOW_ORIGIN=http://<device-ip>:3000
